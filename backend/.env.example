# ============================================================================
# Darshini Backend Environment Configuration
# ============================================================================

# Model weights path (defaults to backend/weights/yolov8n.pt)
MODEL_PATH=weights/yolov8n.pt

# Server host and port
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins for browser cross-origin requests (comma-separated or wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Inference constraints
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_INFERENCE_IMGSZ=416
MAX_UPLOAD_SIZE_MB=50

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
