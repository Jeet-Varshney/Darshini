# ============================================================================
# Darshini Frontend Environment Configuration
# ============================================================================

# Backend API HTTP Endpoint
# In local development: http://localhost:8000
# In production HTTPS: https://api.yourdomain.com (or leave empty if using reverse proxy)
VITE_API_URL=http://localhost:8000

# Backend WebSocket Endpoint
# In local development: ws://localhost:8000
# In production WSS: wss://api.yourdomain.com (or leave empty to auto-derive from VITE_API_URL)
VITE_WS_URL=ws://localhost:8000
